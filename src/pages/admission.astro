---
import Layout from "@/layouts/Layout.astro";
import Footer from "@/components/Footer.astro";
import siteData from "@/data/global/site.json";
import admissionCtas from "@/data/admission/admission-ctas.json";
import admissionData from "@/data/admission/admission.json";
import { withBase } from "@/lib/assetPath";
import { icons } from "@/lib/icons";

const contactMethods = admissionData.contactMethods.map((m) => ({
  ...m,
  value: m.iconKey === "phone" ? siteData.phoneDisplay : siteData.email,
  href: m.iconKey === "phone" ? `tel:${siteData.phone}` : `mailto:${siteData.email}`,
}));

const schema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: `Admission ${siteData.name}`,
  description: admissionData.pageDescription,
  mainEntity: {
    "@type": "LocalBusiness",
    name: siteData.name,
    telephone: siteData.phone,
    email: siteData.email,
  },
};
---

<Layout
  title={admissionData.pageTitle}
  description={admissionData.pageDescription}
  schema={schema}
>
  <div class="px-6 lg:px-12 py-16">
    <div class="max-w-6xl mx-auto">
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 text-sm text-site-muted font-mono">
          <li><a href={withBase('/')} data-astro-reload class="hover:text-white transition-colors">Home</a></li>
          <li class="text-site-border">/</li>
          <li class="text-electric-cyan">Admission</li>
        </ol>
      </nav>

      <div class="grid lg:grid-cols-2 gap-12">
        <!-- Left: Info -->
        <div>
          <h1 class="font-display font-bold text-4xl sm:text-5xl text-white mb-4">{admissionData.heading}</h1>
          <p class="text-site-text-muted text-xl leading-relaxed mb-8">
            {admissionData.subHeading}
          </p>

          <div class="space-y-4 mb-10">
            {contactMethods.map((method) => (
              <a
                href={method.href}
                class="flex items-center gap-4 p-4 rounded-xl border border-site-border/60 bg-site-surface/30 hover:border-electric-blue/30 transition-colors group"
              >
                <div class="p-2.5 rounded-lg bg-electric-blue/10 border border-electric-blue/20 text-electric-cyan flex-shrink-0">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" set:html={icons[method.iconKey]} />
                </div>
                <div class="flex-1">
                  <p class="text-xs text-site-muted font-mono uppercase tracking-wider">{method.label}</p>
                  <p class="text-white font-semibold mt-0.5 group-hover:text-electric-cyan transition-colors">{method.value}</p>
                  <p class="text-site-muted text-xs mt-0.5">{method.note}</p>
                </div>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-site-muted group-hover:text-electric-cyan transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" set:html={icons['arrow-right']} />
              </a>
            ))}
          </div>

          <!-- Free offer callout — populated at page load from admission-ctas.json -->
          <div id="admission-cta" class="p-5 rounded-xl border border-matrix/20 bg-matrix/5" aria-live="polite"></div>
        </div>

        <!-- Right: Admission form (Tally) -->
        <div class="p-1 rounded-2xl border border-site-border bg-site-surface/40 backdrop-blur-sm overflow-hidden">
          <iframe data-tally-src="https://tally.so/embed/q476pO?alignLeft=1&hideTitle=1&dynamicHeight=1&formEventsForwarding=1" loading="lazy" width="100%" height="800" frameborder="0" marginheight="0" marginwidth="0" title="Apply for Skoolage Admission"></iframe>
          <script is:inline>var d=document,w="https://tally.so/widgets/embed.js",v=function(){"undefined"!=typeof Tally?Tally.loadEmbeds():d.querySelectorAll("iframe[data-tally-src]:not([src])").forEach((function(e){e.src=e.dataset.tallySrc}))};if("undefined"!=typeof Tally)v();else if(d.querySelector('script[src="'+w+'"]')==null){var s=d.createElement("script");s.src=w,s.onload=v,s.onerror=v,d.body.appendChild(s);}</script>
        </div>
      </div>
    </div>
  </div>
  <Footer />
</Layout>

<script define:vars={{ admissionCtas }} is:inline>
  const cta = admissionCtas[Math.floor(Math.random() * admissionCtas.length)];
  const ctaEl = document.getElementById('admission-cta');
  if (ctaEl && cta) {
    ctaEl.innerHTML = `
      <div class="flex items-start gap-3">
        <span class="text-2xl" aria-hidden="true">${cta.emoji}</span>
        <div>
          <h3 class="font-semibold text-white mb-1">${cta.title}</h3>
          <p class="text-site-muted text-sm leading-relaxed">${cta.description}</p>
        </div>
      </div>`;
  }
</script>